# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Same Neon Postgres connection string used by the pipeline's .env.
DATABASE_URL=postgresql://<user>:<password>@<endpoint-hostname>.neon.tech/<dbname>?sslmode=require

# Anthropic API key, used by the /ask agent (web/lib/agent.ts).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=<your-anthropic-api-key>
