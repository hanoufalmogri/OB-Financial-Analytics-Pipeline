# Copy this file to .env and fill in real values. Never commit .env.
#
# Neon Postgres connection. Find these in the Neon console under
# Project > Connection Details.

# Single connection string (used by sqlalchemy / ingestion scripts)
DATABASE_URL=postgresql://<user>:<password>@<endpoint-hostname>.neon.tech/<dbname>?sslmode=require

# Discrete fields (used by dbt-postgres profiles.yml in Phase 4)
PGHOST=<endpoint-hostname>.neon.tech
PGPORT=5432
PGDATABASE=<dbname>
PGUSER=<user>
PGPASSWORD=<password>
PGSSLMODE=require
